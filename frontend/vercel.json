{
  "buildCommand": "npx --yes vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://class-pulse-backend-mu.vercel.app/api/:path*"
    },
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ]
}